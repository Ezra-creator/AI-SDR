# Vanguard SDR Configuration

# Groq API Key (required for LLM research synthesis, scoring, and personalization)
GROQ_API_KEY=your_groq_api_key_here

# Neon Serverless Postgres Connection String (required for durable persistence)
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Resend API Key for live email sending
RESEND_API_KEY=re_your_resend_api_key_here

# Default verified sender address (e.g. on onboarding@resend.dev or your custom domain)
RESEND_FROM_EMAIL=Vanguard SDR <onboarding@resend.dev>

# CRITICAL SAFETY OVERRIDE: When set, ALL outgoing emails are intercepted and delivered
# ONLY to this test address, with the real recipient noted in the subject and email body.
# Default is ALWAYS active in development to guarantee zero accidental outreach to real strangers.
TEST_MODE_RECIPIENT_OVERRIDE=test-sdr-recipient@example.com
